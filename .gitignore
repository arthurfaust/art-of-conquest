# Cache e arquivos gerados pela Godot 4
.godot/
/android/
*.tmp

# Arquivos do sistema
desktop.ini
Thumbs.db
.DS_Store

# Executáveis, gravações, vídeos gerados e arquivo local (tudo pode ser gerado de novo)
build/

# Ajuste temporário de resolução usado só para gravar o trailer e o vídeo em 1080p
